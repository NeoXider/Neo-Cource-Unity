.quiz-block {
    margin-top: 10px;
    margin-bottom: 12px;
    padding: 14px 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(72, 160, 255, 0.6);
    background-color: rgba(36, 52, 72, 0.7);
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
}

.quiz-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
    font-size: 15px;
    color: rgb(180, 235, 255);
    white-space: normal;
    overflow: visible;
    min-width: 0;
    flex-grow: 1;
    align-self: stretch;
}

.quiz-answers {
    margin-top: 4px;
    margin-bottom: 4px;
    flex-direction: column;
}

.quiz-answer {
    -unity-font-style: normal;
    background-color: rgba(52, 74, 102, 0.95);
    color: rgb(230, 245, 255);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 6px;
    justify-content: flex-start;
    align-items: center;
    min-height: 28px;
    border-width: 1px;
    border-color: rgba(72, 160, 255, 0.35);
    margin-bottom: 6px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
}

.quiz-answer:active {
    scale: 0.985 0.985;
}

.quiz-answer--selected {
    background-color: rgba(80, 190, 255, 0.35);
    border-color: rgba(80, 190, 255, 1.0);
    border-width: 2px;
    color: rgb(245, 255, 255);
}

.quiz-answer--correct {
    background-color: rgba(0, 255, 160, 0.45);
    border-color: rgba(0, 255, 160, 1.0);
    border-width: 3px;
    color: rgb(255, 255, 255);
}

.quiz-answer--wrong {
    background-color: rgba(255, 90, 90, 0.35);
    border-color: rgba(255, 110, 110, 1.0);
    border-width: 2px;
    color: rgb(255, 240, 240);
}

.quiz-answer:disabled {
    opacity: 0.7;
}

.quiz-answer--correct:disabled,
.quiz-answer--wrong:disabled {
    opacity: 1.0;
}

.quiz-result {
    margin-top: 4px;
    align-self: flex-start;
    color: rgb(200, 215, 230);
}

/* Hover/active (Editor only) */
.quiz-answer:hover {
    background-color: rgba(90, 190, 255, 0.42);
}

/* Неверный ответ, пока попытки ещё есть: короткая красная вспышка (класс снимается через schedule).
   Стоит после :hover и повторён для :hover — курсор в этот момент над кнопкой. */
.quiz-answer--wrong-flash,
.quiz-answer--wrong-flash:hover {
    background-color: rgba(255, 90, 90, 0.5);
    border-color: rgba(255, 110, 110, 1.0);
    color: rgb(255, 240, 240);
}

.quiz-result {
    -unity-font-style: bold;
}

.quiz-result--success {
    color: rgb(90, 240, 170);
}

.quiz-result--fail {
    color: rgb(255, 120, 120);
}

/* Кнопка "Проверить" для check/quiz и ссылок unity://check */
.check-button {
    background-color: rgba(255, 170, 60, 0.95);
    color: rgb(40, 25, 0);
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 210, 120, 1.0);
    min-height: 26px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.check-button:active {
    scale: 0.96 0.96;
}

.check-button:hover {
    background-color: rgba(255, 190, 90, 1.0);
}

/* Состояние кнопки после проверки: зелёная — успех, красная — неуспех */
.check-button--success {
    background-color: rgba(46, 125, 50, 0.95);
    border-color: rgba(105, 240, 174, 1.0);
    color: rgb(255, 255, 255);
    transition-property: background-color, border-color;
    transition-duration: 0.3s;
}

.check-button--fail {
    background-color: rgba(142, 36, 36, 0.95);
    border-color: rgba(255, 138, 128, 1.0);
    color: rgb(255, 255, 255);
    transition-property: background-color, border-color;
    transition-duration: 0.3s;
}

/* :hover специфичнее модификатора — без этих правил проверенная кнопка под курсором снова оранжевая */
.check-button--success:hover {
    background-color: rgba(56, 142, 60, 1.0);
}

.check-button--fail:hover {
    background-color: rgba(164, 46, 46, 1.0);
}

/* Результат проверки (текстовый, для кнопок вне карточки задания). Единственное определение:
   дубль из MarkdownRenderer.uss убран — там были конфликтующие рамки. */
.check-result-label {
    margin-top: 6px;
    padding: 6px 8px;
    border-radius: 6px;
    background-color: rgba(36, 52, 72, 0.7);
    color: rgb(220, 235, 250);
    border-width: 1px;
    border-color: rgba(72, 160, 255, 0.5);
    white-space: normal;
    transition-property: opacity, background-color, border-color;
    transition-duration: 0.25s;
}

/* Эффект верного ответа в квизе: короткий «поп» (снимается через schedule, без USS — no-op) */
.quiz-answer--just-correct {
    scale: 1.12;
    background-color: #2e7d32;
    border-color: #a5ffb0;
    transition-property: scale, background-color;
    transition-duration: 0.35s;
}

.quiz-result--pop {
    scale: 1.15;
    transition-property: scale;
    transition-duration: 0.3s;
}

/* Эффекты автопроверки: появление результата + «толчок» при неуспехе */
.check-result--show {
    opacity: 1;
}

.check-result--fail-shake {
    background-color: rgba(255, 90, 90, 0.45);
    border-color: rgba(255, 110, 110, 1.0);
}

/* ---------- Карточка практического задания (вместо сырого YAML блока check) ---------- */
.check-card {
    margin-top: 10px;
    margin-bottom: 12px;
    padding: 12px 14px;
    border-radius: 8px;
    border-width: 1px;
    border-left-width: 3px;
    border-color: rgba(255, 170, 60, 0.45);
    border-left-color: rgb(255, 170, 60);
    background-color: rgba(48, 38, 24, 0.55);
    transition-property: border-color, background-color;
    transition-duration: 0.3s;
}

.check-card--done {
    border-color: rgba(105, 240, 174, 0.5);
    border-left-color: rgb(105, 240, 174);
    background-color: rgba(24, 48, 36, 0.55);
}

.check-card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.check-card__title {
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(255, 214, 150);
    flex-shrink: 1;
    white-space: normal;
}

.check-card--done .check-card__title {
    color: rgb(160, 245, 200);
}

.check-card__status {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(190, 198, 210);
    flex-shrink: 0;
    margin-left: 8px;
    transition-property: scale, background-color, color;
    transition-duration: 0.2s;
}

.check-card__status--ok {
    background-color: rgba(46, 160, 90, 0.35);
    color: rgb(170, 255, 205);
}

.check-card__status--fail {
    background-color: rgba(200, 70, 70, 0.3);
    color: rgb(255, 190, 185);
}

.check-card__status--pop {
    scale: 1.12 1.12;
}

.check-rule {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px 6px;
    margin-bottom: 2px;
    border-radius: 5px;
    transition-property: background-color;
    transition-duration: 0.25s;
}

.check-rule__icon {
    width: 18px;
    min-width: 18px;
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    color: rgb(150, 158, 172);
    transition-property: color, scale;
    transition-duration: 0.2s;
}

.check-rule__texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.check-rule__text {
    white-space: normal;
    color: rgb(226, 232, 240);
}

.check-rule__hint {
    white-space: normal;
    font-size: 11px;
    color: rgb(255, 170, 160);
    margin-top: 1px;
}

.check-rule--ok {
    background-color: rgba(46, 160, 90, 0.16);
}

.check-rule--ok .check-rule__icon {
    color: rgb(105, 240, 174);
    scale: 1.15 1.15;
}

.check-rule--fail {
    background-color: rgba(200, 70, 70, 0.16);
}

.check-rule--fail .check-rule__icon {
    color: rgb(255, 120, 110);
    scale: 1.15 1.15;
}

.check-card__footer {
    flex-direction: row;
    margin-top: 8px;
}
