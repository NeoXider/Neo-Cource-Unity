/* Здесь были два правила с `resource("Icons/Animation.Play.png")`.
   `resource(...)` тянет ВСТРОЕННУЮ ИКОНКУ РЕДАКТОРА: она существует только в Unity Editor,
   а в player-сборке (WebGL) её нет. Итог в билде — пустой прямоугольник вместо кнопки
   и `Image not found for path: ...` в консоли на каждое открытие видео. Этот USS попадает
   в рантайм (его импортируют PresentationPanel.uxml и BriefingFullscreenOverlay.uxml),
   поэтому editor-only ресурсам тут не место. Перекрыть селектор снаружи нельзя —
   объявление всё равно резолвится и мусорит в лог, его надо удалять физически. */

.video-control-bar {
  height: 48px;
  width: 100%;
  background-color: var(--rs-code-surface, rgb(36, 40, 48));

  flex-direction: column;

  transform-origin: bottom center;
  scale: 1 1;

  transition: scale 0.1s ease-in;
}

.video-control-button {
  width: 72px;
  flex-shrink: 0;
}

.video-play-track {
  height: 8px;
  background-color: var(--rs-code-surface-strong, rgb(24, 27, 33));
  flex-grow: 0;
}

.video-play-track-filler {
  width: 100%;
  height: 100%;
}

.video-control-container {
  flex-direction: row;
  height: 40px;
}

.video-play-button {
  /* Был `resource('d_Animation.Play@2x')` — editor-only иконка, в билде её нет.
     HighResPlay.png лежит рядом с этим USS и уже используется `.video-play-overlay-button`,
     то есть попадает в сборку и работает в плеере. */
  background-image: url('HighResPlay.png');
  -unity-background-scale-mode: scale-to-fit;
}

.video-pause-button {
  /* Во время воспроизведения видна подпись «Пауза», созданная runtime-контролом. */
  -unity-background-scale-mode: scale-to-fit;
}

.video-speed-button {
  width: 36px;
  flex-grow: 0;
}

.video-speed-label {
  color: var(--rs-code-md-text, rgb(220, 226, 235));
  -unity-text-align: middle-center;
  margin: 0;
  padding: 0;
  height: 100%;
  width: 100%;
}

.video-speed-label-container {
  padding: 1px;
}

.video-speed-label-container:hover {
  border-color: var(--rs-code-md-text, rgb(220, 226, 235));
  border-width: 1px;
  padding: 1px;
  background-color: var(--rs-code-surface, rgb(36, 40, 48));
}

.video-speed-label-container.selected {
  padding: 0px;
  border-color: var(--rs-code-function, rgb(84, 196, 255));
  border-width: 1px;
}


.video-speed-selector {
  height: 100px;
  background-color: var(--rs-code-surface, rgb(36, 40, 48));

  position: absolute;
  left: 0;
  right: 0;
  top: -100px;

  transform-origin: bottom;

  scale: 1 0;

  transition: scale 0.1s ease-in;
}

.video-speed-selector-opened {
  scale: 1 1;
}

.video-audio-icon {
  /* Подпись «Звук» работает без ресурсов редактора. */
  width: 72px;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.video-audio-slider {
  width: 100px;
}

.video-control-button:hover {
  -unity-background-image-tint-color: var(--rs-code-function, rgb(84, 196, 255));
}

.video-popup-button {
  /* Подпись «Открыть» работает без ресурсов редактора. */
  -unity-background-scale-mode: scale-to-fit;
}

.video-play-track-filler {
  background-color: var(--rs-code-function, rgb(84, 196, 255));
}

.video-play-track-head {
  width: 6px;

  top: -2px;
  bottom: -2px;

  position: absolute;
  flex-grow: 0;

  background-color: var(--rs-code-md-text, rgb(220, 226, 235));
  right: -6px;
}

.video-play-overlay {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.2);

  align-content: center;
  align-items: center;
}

.video-play-overlay-button {
  width: 50px;
  height: 50px;

  flex-grow: 1.0;

  background-image: url('HighResPlay.png');
  -unity-background-scale-mode: scale-to-fit;

  align-self: center;
}

.video-content {
  height: 100%;
  min-height: 180px;
  width: 100%;
  -unity-background-scale-mode: scale-to-fit;

  flex-direction: column-reverse;

  background-color: var(--rs-code-md-bg, rgb(18, 22, 30));
  align-items: flex-start;
  justify-content: flex-start;

  flex-shrink: 0;
  flex-grow: 0;
}

.video-content:hover .image-popout-button {
  visibility: visible;
}

.video-control-button:hover {
  -unity-background-image-tint-color: var(--rs-code-function, rgb(84, 196, 255));
}

.video-content:hover .video-control-bar {
  scale: 1 1;
}

.popout-media .video-control-bar {
  scale: 1 1;
}

.popout-media {
  flex-shrink: 0;
  flex-grow: 1;
}

/* Подписи — часть работающих органов управления; декоративные редакторские иконки не нужны. */
.video-content .video-control-label,
.video-content .video-pause-label,
.video-speed-button #SpeedLabel {
  flex-grow: 1;
  color: var(--rs-code-md-text, rgb(220, 226, 235));
  font-size: 14px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  margin: 0;
  padding: 0 3px;
}

.video-control-button,
.video-audio-icon {
  justify-content: center;
  align-items: stretch;
  border-width: 1px;
  border-color: var(--rs-code-border, rgba(120, 140, 170, 0.35));
  border-radius: 8px;
  background-color: var(--rs-code-surface-strong, rgb(24, 27, 33));
}

.video-play-button .video-pause-label {
  display: none;
}

.video-control-button:hover,
.video-audio-icon:hover {
  background-color: var(--rs-code-surface, rgb(36, 40, 48));
}

.video-audio-slider .unity-base-slider__tracker {
  background-color: var(--rs-code-border, rgba(120, 140, 170, 0.35));
}

.video-audio-slider .unity-base-slider__dragger {
  background-color: var(--rs-code-function, rgb(84, 196, 255));
}

/* Ошибка остаётся читаемой и в видео, вложенном в светлый разговор. */
.video-content .video-error-label {
  color: var(--rs-code-md-text, rgb(220, 226, 235));
  background-color: var(--rs-code-surface, rgb(36, 40, 48));
  white-space: normal;
  padding: 8px;
}
