.algo-course-window {
    background-color: rgb(18, 22, 30);
}

.algo-course-toolbar {
    min-height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: rgba(24, 29, 39, 0.98);
}

.algo-course-dropdown {
    flex-grow: 1;
    min-width: 120px;
    min-height: 24px;
    margin-right: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(96, 127, 176, 0.4);
    background-color: rgba(34, 42, 56, 1);
    color: rgb(231, 238, 247);
    font-size: 12px;
}

.algo-course-navbar {
    min-height: 34px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: rgba(21, 26, 35, 0.98);
}

.algo-course-continue {
    min-height: 24px;
    margin-left: 6px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(106, 176, 255, 0.55);
    background-color: rgba(38, 66, 102, 0.9);
    color: rgb(220, 236, 255);
    font-size: 12px;
}

.algo-course-continue:hover {
    background-color: rgba(52, 88, 134, 1);
    border-color: rgba(140, 200, 255, 0.8);
}

.algo-course-continue:disabled {
    opacity: 0.4;
}

.algo-course-empty-box {
    align-items: center;
    padding-top: 20px;
    padding-bottom: 24px;
    padding-left: 12px;
    padding-right: 12px;
}

.algo-course-empty-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(170, 255, 150);
    margin-bottom: 6px;
}

.algo-course-empty-desc {
    font-size: 12px;
    color: rgb(170, 180, 195);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.algo-course-empty-button {
    min-height: 26px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(106, 176, 255, 0.55);
    background-color: rgba(38, 66, 102, 0.9);
    color: rgb(220, 236, 255);
    font-size: 12px;
}

.algo-course-empty-button:hover {
    background-color: rgba(52, 88, 134, 1);
}

.algo-course-icon-button,
.algo-course-nav-button,
.algo-course-docs-menu {
    min-height: 24px;
    min-width: 26px;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(100, 127, 171, 0.25);
    background-color: rgba(35, 42, 56, 0.96);
    color: rgb(223, 232, 245);
}

.algo-course-icon-button:hover,
.algo-course-nav-button:hover,
.algo-course-docs-menu:hover {
    background-color: rgba(49, 60, 80, 1);
}

.algo-course-nav-button {
    min-width: 30px;
    max-width: 30px;
    min-height: 24px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.algo-course-nav-button.prev {
    color: rgb(145, 187, 255);
}

.algo-course-nav-button.next {
    color: rgb(124, 232, 183);
}

.algo-course-icon-button.reload {
    border-color: rgba(67, 198, 214, 0.45);
}

.algo-course-icon-button.reset {
    border-color: rgba(226, 109, 109, 0.45);
}

.algo-course-icon-button.settings {
    border-color: rgba(152, 122, 223, 0.42);
}

.algo-course-slide-indicator {
    min-width: 56px;
    margin-left: 4px;
    margin-right: 4px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 6px;
    background-color: rgba(14, 18, 25, 0.95);
    color: rgb(207, 220, 235);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.algo-course-content {
    margin: 8px 10px 10px 10px;
    padding: 12px 14px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(74, 100, 141, 0.24);
    background-color: rgba(20, 24, 33, 0.86);
}

.algo-course-docs-menu {
    min-height: 24px;
    padding-left: 8px;
    padding-right: 8px;
}

.algo-course-progress-wrap {
    flex-direction: column;
    margin: 1px 8px 3px 8px;
}

.algo-course-progress {
    height: 8px;
    background-color: #262a32;
    border-radius: 4px;
    overflow: hidden;
    flex-direction: row;
}

.algo-course-progress-fill {
    height: 100%;
    width: 0%;
    background-color: #ff9933;
    border-radius: 4px;
    transition-property: width, background-color;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.algo-course-progress-label {
    font-size: 10px;
    color: #9aa0aa;
    margin-left: 8px;
    margin-bottom: 2px;
}

/* ---------- Отклик кнопок: плавная подсветка и лёгкое нажатие ---------- */
.algo-course-icon-button,
.algo-course-nav-button,
.algo-course-docs-menu,
.algo-course-continue,
.algo-course-empty-button {
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.12s;
}

.algo-course-icon-button:active,
.algo-course-nav-button:active,
.algo-course-continue:active,
.algo-course-empty-button:active {
    scale: 0.93 0.93;
}

.algo-course-nav-button:disabled,
.algo-course-icon-button:disabled {
    opacity: 0.35;
}

.algo-course-empty-box {
    transition-property: opacity;
    transition-duration: 0.3s;
}

/* ---------- Смена слайда: содержимое въезжает со стороны движения ---------- */
.algo-slide {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.algo-slide--from-right {
    opacity: 0;
    translate: 22px 0;
    transition-duration: 0s;
}

.algo-slide--from-left {
    opacity: 0;
    translate: -22px 0;
    transition-duration: 0s;
}

/* ---------- Тема слайдов: одна палитра вместо кислотных цветов рендерера ---------- */
.algo-course-content .mainBody {
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

.algo-course-content .block {
    margin-top: 5px;
    margin-bottom: 5px;
    /* У рендерера блок — колонка с flex-wrap: wrap. На высоком слайде такая колонка «переносила» часть
       содержимого во второй столбец за правым краем окна (список в цитате, последняя строка кода).
       Без переноса содержимое блока всегда идёт сверху вниз и занимает ширину слайда. */
    flex-wrap: nowrap;
}

/* Кнопка вне карточки задания не растягивается на всю ширину блока. */
.algo-course-content .block > .check-button {
    align-self: flex-start;
}

.algo-course-content .paragraph,
.algo-course-content .list {
    color: rgb(214, 222, 233);
    font-size: 13px;
}

.algo-course-content .h1 {
    font-size: 22px;
    color: rgb(240, 245, 252);
    padding-bottom: 5px;
    margin-bottom: 4px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 153, 51, 0.75);
}

.algo-course-content .h2 {
    font-size: 18px;
    color: rgb(255, 199, 115);
    margin-top: 2px;
}

.algo-course-content .h3 {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(122, 214, 255);
}

.algo-course-content .quote {
    margin-left: 0;
    padding: 7px 12px;
    border-left-width: 3px;
    border-left-color: rgb(84, 196, 255);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(84, 196, 255, 0.09);
}

.algo-course-content .codeblock {
    margin: 6px 0;
    padding: 9px 12px;
    border-width: 1px;
    border-color: rgba(120, 140, 170, 0.32);
    border-radius: 8px;
    background-color: rgb(13, 17, 23);
}

.algo-course-content .codeblock Label {
    color: rgb(222, 230, 240);
    /* Длинная строка кода переносится, а не уезжает за край окна. */
    white-space: normal;
}

.algo-course-content .line {
    height: 1px;
    border-width: 0;
    margin-top: 8px;
    margin-bottom: 8px;
    background-color: rgba(120, 140, 170, 0.3);
}

.algo-course-content .md-image {
    border-radius: 8px;
}

/* Бегунок дорожки видео выступает за её правый край и в конце ролика выходил за ширину слайда. */
.algo-course-content VideoPlayerElement {
    overflow: hidden;
}

/* ---------- Таблицы (pipe tables) ----------
   Дерево рендерера: .md-table > .md-table-row (шапка: + .md-table-header, каждая вторая строка тела:
   + .md-table-row--alt) > .md-table-cell (+ --left / --center / --right по строке-разделителю; само
   выравнивание и ширину колонок рендерер задаёт инлайном). Здесь — цвета, рамки и отступы.
   Внешняя рамка со скруглением — у таблицы; линии между строками — верхняя рамка строки (у шапки её
   нет), между колонками — правая рамка ячейки. Строка на 1px шире содержимого таблицы, поэтому правая
   рамка последней ячейки уходит под обрезку (overflow: hidden) и не двоит внешнюю рамку. */
.algo-course-content .md-table {
    margin-top: 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(120, 140, 170, 0.35);
    border-radius: 6px;
    overflow: hidden;
}

.algo-course-content .md-table-row {
    margin-right: -1px;
    border-top-width: 1px;
    border-color: rgba(120, 140, 170, 0.35);
}

.algo-course-content .md-table-header {
    border-top-width: 0;
    background-color: rgba(84, 196, 255, 0.12);
}

.algo-course-content .md-table-row--alt {
    background-color: rgba(255, 255, 255, 0.035);
}

.algo-course-content .md-table-cell {
    padding: 5px 9px;
    border-right-width: 1px;
    border-bottom-width: 0;
    border-color: rgba(120, 140, 170, 0.35);
}

.algo-course-content .md-table-cell .block {
    margin-top: 0;
    margin-bottom: 0;
}

.algo-course-content .md-table-cell Label {
    font-size: 13px;
    color: rgb(214, 222, 233);
}

.algo-course-content .md-table-header Label {
    -unity-font-style: bold;
    color: rgb(214, 222, 233);
}
